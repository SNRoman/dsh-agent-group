{
  "name": "dsh-agent-group-root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build:host": "pnpm --filter @dsh-agent-group/host run build",
    "build:web": "pnpm --filter @dsh-agent-group/web run build",
    "build:bundle": "pnpm --filter dsh-agent-group run build",
    "build": "pnpm build:host && pnpm build:web && pnpm build:bundle",
    "test": "vitest run",
    "test:dsh-source": "node scripts/test-dsh-source.mjs",
    "test:e2e:browser": "pnpm release:pack && node scripts/release-smoke.mjs --mode packed",
    "export:forward-v1": "node scripts/export-forward-v1.mjs",
    "typecheck": "tsc -b tsconfig.host.json && tsc -b packages/web/tsconfig.client.json && tsc -p tests/types/tsconfig.json --noEmit && tsc -p tests/fixtures/browser/tsconfig.json",
    "verify:compatibility": "node scripts/verify-compatibility.mjs",
    "verify:client-copy": "node scripts/verify-client-copy.mjs",
    "release:check": "pnpm verify:client-copy && pnpm build && pnpm typecheck && pnpm test",
    "release:pack": "pnpm release:check && node scripts/release.mjs pack",
    "release:publish": "pnpm release:check && node scripts/release.mjs publish",
    "smoke:packed": "node scripts/release-smoke.mjs --mode packed",
    "smoke:registry": "node scripts/release-smoke.mjs --mode registry"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cosmokit": "^1.8.3",
    "@deepseek-ai/dsh-agent": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-brand": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-invariants": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-scope": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-storage": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-storage-json": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-typert-generator": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "^18.2.0",
    "canonicalize": "2.1.0",
    "execa": "^10.0.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.61.1",
    "react": "^18.3.1",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
