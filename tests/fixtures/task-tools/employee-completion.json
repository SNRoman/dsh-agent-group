{
  "schemas": [
    {
      "name": "workspace_delegate_task",
      "parameters": {
        "type": "object",
        "properties": {
          "rootTaskId": {
            "type": "string",
            "description": "Durable Agent Workspace task id."
          },
          "assigneeAgentId": {
            "type": "string",
            "description": "Durable id of the employed agent that should receive the peer task."
          },
          "title": {
            "type": "string",
            "description": "Complete title and instruction for the delegated task."
          }
        },
        "required": ["rootTaskId", "assigneeAgentId", "title"]
      }
    },
    {
      "name": "workspace_run_child",
      "parameters": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "description": "Durable Agent Workspace task id."
          },
          "prompt": {
            "type": "string",
            "description": "Complete prompt for the one-shot child."
          }
        },
        "required": ["taskId", "prompt"]
      }
    },
    {
      "name": "workspace_complete_task",
      "parameters": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "description": "Durable Agent Workspace task id."
          },
          "result": {
            "type": "string",
            "description": "Complete textual task result to store durably."
          }
        },
        "required": ["taskId", "result"]
      }
    },
    {
      "name": "workspace_search_memory",
      "parameters": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "description": "Non-empty words or a phrase describing the remembered fact." }
        },
        "required": ["query"]
      }
    },
    {
      "name": "workspace_read_memory",
      "parameters": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "description": "An event id returned by personal memory recall or search." },
          "offset": { "type": "integer", "description": "Zero-based character offset; defaults to 0." }
        },
        "required": ["eventId"]
      }
    }
  ],
  "execution": {
    "isError": false,
    "content": [
      {
        "type": "text",
        "text": "Completed task task-5."
      }
    ],
    "concludesTurn": true,
    "value": {
      "taskId": "task-5",
      "attemptId": "task-delivery-attempt-8",
      "status": "completed"
    }
  }
}
