{
  "name": "@dsh-agent-group/host",
  "version": "0.4.0",
  "description": "Durable Agent Organization domain and colleague runtime for DeepSeek Harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SNRoman/dsh-agent-group.git",
    "directory": "packages/host"
  },
  "homepage": "https://github.com/SNRoman/dsh-agent-group#readme",
  "bugs": {
    "url": "https://github.com/SNRoman/dsh-agent-group/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./web-rpc": {
      "types": "./lib/types/web-rpc.d.ts",
      "default": "./lib/types/web-rpc.js"
    },
    "./forward-export": {
      "types": "./lib/types/forward-export.d.ts",
      "default": "./lib/types/forward-export.js"
    },
    "./workspace-import": {
      "types": "./lib/types/workspace-import.d.ts",
      "default": "./lib/types/workspace-import.js"
    },
    "./workspace-portable": {
      "types": "./lib/types/workspace-portable.d.ts",
      "default": "./lib/types/workspace-portable.js"
    },
    "./workflow-contract": {
      "types": "./lib/types/workflow-contract.d.ts",
      "default": "./lib/types/workflow-contract.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "src/**/*.ts"
  ],
  "scripts": {
    "build": "tsc -b && tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-brand": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.2.1-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "canonicalize": "2.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-brand": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.2.1-0",
    "@deepseek-ai/dsh-typert-generator": ">=0.2.0-rc.2 <0.2.1-0"
