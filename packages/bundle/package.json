{
  "name": "dsh-agent-group",
  "version": "0.1.0",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@dsh-agent-group/host": "workspace:^",
    "@dsh-agent-group/web": "workspace:^",
    "@deepseek-ai/dsh-storage": ">=0.1.0-rc.7 <0.2.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0-rc.7 <0.2.0",
    "@deepseek-ai/dsh-storage-json": ">=0.1.0-rc.7 <0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.7 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.7 <0.2.0"
  }
}
