{
  "name": "dsh-agent-group",
  "version": "0.1.0",
  "description": "Installable multi-agent workspace profile bundle for DeepSeek Harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SNRoman/dsh-agent-group.git",
    "directory": "packages/bundle"
  },
  "homepage": "https://github.com/SNRoman/dsh-agent-group#readme",
  "bugs": {
    "url": "https://github.com/SNRoman/dsh-agent-group/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "agent",
    "multi-agent",
    "workspace"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "src/**/*.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@dsh-agent-group/host": "workspace:^",
    "@dsh-agent-group/web": "workspace:^",
    "@deepseek-ai/dsh-storage": ">=0.1.1-rc.2 <0.1.2-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.1-rc.2 <0.1.2-0",
    "@deepseek-ai/dsh-storage-json": ">=0.1.1-rc.2 <0.1.2-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
